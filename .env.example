# Copy this file to .env (for local `vercel dev`) and/or set these in the Vercel
# project's Settings → Environment Variables. Never commit real values.
#
# See README.md → "Modo online (Supabase)" for how to obtain each of these.

# Public Supabase project URL and anon key. Safe to expose to the browser (Vite only
# bundles VITE_-prefixed vars into the client) — Row Level Security restricts the anon
# key to read-only access on the `games` table (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret (used exclusively inside /api/*, never sent to the browser).
# Supabase project → Settings → API → "service_role" key. Bypasses Row Level Security,
# which is what makes the server the sole source of truth for game state.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to sign the guest-identity cookie and to hash IPs for rate
# limiting, and as the bearer token for POST /api/games/cleanup. Any long random string,
# e.g. generate one with: openssl rand -hex 32
AUTH_SECRET=

# Base URL of the ai-service/ Python inference service (see ai-service/src/service.py),
# used by the "Experta" AI difficulty (19x19 boards only). Defaults to
# http://localhost:8000 if unset -- fine for local development against
# `uvicorn src.service:app`. In production this must point at the ai-service/ instance
# deployed on Render (see ai-service/render.yaml); set it in the Vercel project's
# Environment Variables to that Render service's URL.
VITE_AI_SERVICE_URL=
