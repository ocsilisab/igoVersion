# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (never commit real secrets — see .env.example)
.env
.env.*
!.env.example
.vercel

# AI service (Python): venv and downloaded dataset never get committed. checkpoints/
# is ignored too EXCEPT best.pt / best_<size>x<size>.pt -- those are the trained weights
# the deployed service actually serves, so they need to be in git for Docker builds on a
# host that only has the repo, not this machine's local training run.
ai-service/.venv
ai-service/data/*
!ai-service/data/.gitkeep
ai-service/checkpoints/*
!ai-service/checkpoints/.gitkeep
!ai-service/checkpoints/best.pt
!ai-service/checkpoints/best_9x9.pt
!ai-service/checkpoints/best_13x13.pt
# Policy+Value checkpoint (see train_policy_value.py) -- same reasoning, only best.pt
# (not last.pt, which is resume-only state) needs to ship for Render's Docker build.
!ai-service/checkpoints/policy_value
!ai-service/checkpoints/policy_value/best.pt
ai-service/checkpoints/policy_value/last.pt
ai-service/checkpoints_9x9
ai-service/checkpoints_13x13
ai-service/__pycache__
ai-service/**/__pycache__
ai-service/.pytest_cache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
