# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (never commit real secrets — see .env.example)
.env
.env.*
!.env.example
.vercel

# AI service (Python): venv and downloaded dataset never get committed. checkpoints/
# is ignored too EXCEPT best.pt (~6MB) -- that's the trained weights the deployed
# service actually serves, so it needs to be in git for Docker builds on a host that
# only has the repo, not this machine's local training run.
ai-service/.venv
ai-service/data/*
!ai-service/data/.gitkeep
ai-service/checkpoints/*
!ai-service/checkpoints/.gitkeep
!ai-service/checkpoints/best.pt
ai-service/__pycache__
ai-service/**/__pycache__
ai-service/.pytest_cache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
